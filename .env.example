# PostgreSQL bağlantısı (Supabase / Neon / kendi sunucunuz). Şema ilk istekte otomatik kurulur.
DATABASE_URL=postgres://kullanici:sifre@sunucu:5432/kafulluk?sslmode=require
# Panelin İLK girişi için: kullanıcı adı "admin" + bu şifre → yönetici hesabı oluşur.
# Sonrasında kullanıcılar panelden yönetilir.
ADMIN_PASSWORD=
# Oturum imzalama anahtarı — uzun, rastgele bir metin (örn. `openssl rand -hex 32`). Değiştirilirse tüm oturumlar kapanır.
SESSION_SECRET=
# İsteğe bağlı: AI ürün danışmanı
LOVABLE_API_KEY=
