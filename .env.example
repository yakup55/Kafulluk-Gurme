# PostgreSQL bağlantısı (Supabase / Neon / kendi sunucunuz). Şema ilk istekte otomatik kurulur.
DATABASE_URL=postgres://kullanici:sifre@sunucu:5432/kafulluk?sslmode=require
# Satıcı paneli (/satici.html) şifresi
ADMIN_PASSWORD=
# Oturum imzalama anahtarı — uzun, rastgele bir metin (örn. `openssl rand -hex 32`)
SESSION_SECRET=
# İsteğe bağlı: AI ürün danışmanı
LOVABLE_API_KEY=
